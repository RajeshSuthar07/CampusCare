{
  "name": "campuscare-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CampusCare API - Express + MongoDB (Vercel serverless compatible)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
