# ---- Required ----
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (placeholders only - never commit the real one)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/campuscare?retryWrites=true&w=majority
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
# Exact browser origin(s) of the frontend, comma-separated, no trailing slash
FRONTEND_URL=http://localhost:5173

# ---- Optional ----
JWT_EXPIRES_IN_HOURS=8
# Only if you need cookies shared across subdomains (e.g. .example.com). Leave empty on *.vercel.app.
COOKIE_DOMAIN=
# lax | strict | none. Default: "none" in production (separate frontend/backend domains), "lax" in development.
COOKIE_SAMESITE=

# Image uploads (Cloudinary). Leave empty to disable uploads - complaints still work without images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local seeding only (npm run seed:admin). Never set these on Vercel.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
